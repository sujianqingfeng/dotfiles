source "$HOME/.zsh/exec.zsh"
source "$HOME/.zsh/alias.zsh"
source "$HOME/.zsh/fnm.zsh"
source "$HOME/.zsh/proxy.zsh"

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="spaceship-prompt/spaceship"

plugins=(
  zsh-autosuggestions
  zsh-syntax-highlighting
  z
  vi-mode
)

source "$ZSH/oh-my-zsh.sh"

export PATH="$HOME/.local/bin:$PATH"

# Bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# Homebrew OpenJDK 17, supporting Apple Silicon and Intel Macs.
for java_home in \
  /opt/homebrew/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home \
  /usr/local/opt/openjdk@17/libexec/openjdk.jdk/Contents/Home; do
  if [ -d "$java_home" ]; then
    export JAVA_HOME="$java_home"
    export PATH="$JAVA_HOME/bin:$PATH"
    break
  fi
done
unset java_home

if [ -d "$HOME/.antigravity/antigravity/bin" ]; then
  export PATH="$HOME/.antigravity/antigravity/bin:$PATH"
fi

if [ -d "$HOME/.grok/bin" ]; then
  export PATH="$HOME/.grok/bin:$PATH"
  fpath=("$HOME/.grok/completions/zsh" $fpath)
  autoload -Uz compinit && compinit -C
fi

if [ -r "$HOME/.zsh/codex-env.zsh" ]; then
  source "$HOME/.zsh/codex-env.zsh"
fi

# Otty exposes this path only for shells launched inside Otty.
if [ -n "$OTTY_SHELL_INTEGRATION" ] && [ -r "$OTTY_SHELL_INTEGRATION/otty-integration.zsh" ]; then
  source "$OTTY_SHELL_INTEGRATION/otty-integration.zsh"
fi
